PORT=5000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/jntuaresults
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed front-end origins
CLIENT_ORIGIN=http://localhost:5173,https://jntuaresults.vercel.app
# First admin (used by: npm run seed-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
# Cloudflare R2 (file storage). Leave blank in local dev to store files in ./uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# hCaptcha secret (https://dashboard.hcaptcha.com). Required in production; blank = skipped in local dev.
HCAPTCHA_SECRET=
